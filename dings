    .hero-image img {
      object-fit: contain;
      object-position: center;
    }

    .hero-slot::before {
      position: absolute;
      top: 12px;
      left: -28%;
      z-index: 5;
      width: 22%;
      height: calc(100% - 24px);
      content: "";
      background: linear-gradient(90deg, transparent 0 28%, rgba(255, 255, 255, 0.04) 28% 34%, rgba(255, 242, 172, 0.62) 34% 52%, rgba(255, 242, 172, 0.2) 52% 70%, transparent 70% 100%);
