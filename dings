        10px 10px,
        10px 0,
        calc(100% - 10px) 0,
        calc(100% - 10px) 10px,
        100% 10px,
        100% calc(100% - 10px),
        calc(100% - 10px) calc(100% - 10px),
        calc(100% - 10px) 100%,
        10px 100%,
        10px calc(100% - 10px),
        0 calc(100% - 10px)
