        linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 100%);
      background-repeat: no-repeat;
      background-position: center top;
      background-size: cover;
      image-rendering: pixelated;
      overflow-x: hidden;
    }

    .shell {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(100%, 620px);
      min-height: 100vh;
      margin: 0 auto;
      padding: clamp(14px, 3vw, 28px);
      gap: clamp(12px, 2.5vw, 18px);
      justify-content: center;
    }

    .card {
      width: 100%;
      max-width: none;
      padding: clamp(14px, 2.6vw, 20px);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0 4px, transparent 4px 100%),
        linear-gradient(180deg, var(--panel-top) 0%, var(--panel-bottom) 100%);
      border: 4px solid var(--gold-deep);
      box-shadow:
        inset 0 0 0 2px var(--gold-soft),
        inset 0 0 0 6px var(--royal-soft),
        inset 0 0 0 8px #11173d,
        0 0 0 4px rgba(10, 185, 216, 0.98),
        0 0 0 8px #22306f,
        var(--shadow);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: clamp(14px, 3vw, 18px);
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0 2px, transparent 2px 8px),
        linear-gradient(90deg, transparent 0 5%, rgba(255, 242, 172, 0.08) 5% 7%, transparent 7% 93%, rgba(255, 242, 172, 0.08) 93% 95%, transparent 95% 100%);
      pointer-events: none;
    }

    .card::after {
      content: "";
      position: absolute;
      inset: 12px;
      border: 3px solid rgba(37, 207, 219, 0.34);
      box-shadow: inset 0 0 0 2px rgba(20, 28, 70, 0.95);
      pointer-events: none;
    }

    .logo-slot,
    .hero-slot,
    .actions {
      position: relative;
      z-index: 1;
      width: 100%;
      isolation: isolate;
      border: 4px solid var(--gold-deep);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0 3px, transparent 3px 100%),
        linear-gradient(180deg, #16b8d4fa, rgba(0, 0, 0, 0.98));
