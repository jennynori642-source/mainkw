      top: 4px;
      left: -30%;
      width: 22%;
      height: calc(100% - 8px);
      background: linear-gradient(90deg, transparent 0 28%, rgba(255, 255, 255, 0.04) 28% 34%, rgba(255, 242, 172, 0.72) 34% 52%, rgba(255, 242, 172, 0.2) 52% 68%, transparent 68% 100%);
