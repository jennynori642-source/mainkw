        inset 0 -4px 0 rgba(42, 36, 11, 0.98),
        0 0 0 3px #11d6dd,
        0 6px 0 rgba(20, 19, 6, 0.98);
      text-shadow: 2px 2px 0 rgba(43, 39, 12, 0.95);
    }

    .button-secondary::after {
      animation-delay: 0.5s;
    }

    .button-primary:hover,
    .button-secondary:hover {
      transform: translateY(1px);
    }

    .button-primary:hover {
      box-shadow:
        inset 0 0 0 2px rgba(255, 247, 216, 0.92),
        inset 0 -4px 0 #11d6dd,
        0 0 0 3px #11d6dd,
        0 4px 0 rgba(20, 19, 6, 0.98);
    }

    .button-secondary:hover {
      box-shadow:
        inset 0 0 0 2px rgba(255, 255, 255, 0.2),
        inset 0 -4px 0 rgba(9, 185, 230, 0.98),
        0 0 0 3px #11d6dd,
        0 4px 0 rgba(20, 19, 6, 0.98);
    }

    .button-text {
