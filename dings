      display: block;
      padding-top: 1px;
    }

    @keyframes royal-glint {
      0% {
        transform: translateX(0);
        opacity: 0;
      }

      8% {
        opacity: 0.55;
      }

      40% {
        transform: translateX(520%);
        opacity: 0.4;
      }

      46% {
        opacity: 0;
      }

      100% {
        transform: translateX(520%);
        opacity: 0;
      }
    }

    @media (max-width: 480px) {
      .shell {
        width: 100%;
        min-height: auto;
