    .logo-slot {
      padding: 0;
    }

    .hero-slot {
      padding: 0;
    }

    .actions {
      padding: 16px;
      gap: 14px;
    }

    .logo-slot::after,
    .hero-slot::after,
    .actions::after {
      content: "";
      position: absolute;
      inset: 12px;
      z-index: 4;
      background:
        repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0 2px, transparent 2px 8px),
